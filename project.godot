; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Dragon Bowling 2"
config/version="1.0.1-db2"
run/main_scene="res://scene/abertura.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
boot_splash/show_image=true
boot_splash/image="res://sprites/marca/splash_giro_1.png"
boot_splash/stretch_mode=5
boot_splash/bg_color=Color(0, 0, 0, 1)
config/icon="res://sprites/icone_dragon_bowling_2.png"

[autoload]

Tela="*res://autoload/Tela.gd"
MusicManager="*res://scripts/music_manager.gd"
GameConfig="*res://autoload/GameConfig.gd"
ArduinoBridge="*res://autoload/ArduinoBridge.gd"
ArcadeControls="*res://autoload/ArcadeControls.gd"

[display]

window/size/viewport_width=1536
window/size/viewport_height=1024
window/size/mode=3
window/handheld/orientation=0
window/stretch/mode="canvas_items"
window/stretch/aspect="ignore"

[dragon]

tela/giro=1

[editor_plugins]

enabled=PackedStringArray()

